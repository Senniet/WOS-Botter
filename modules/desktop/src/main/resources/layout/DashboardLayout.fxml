<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
    <content>
        <VBox spacing="18" styleClass="dashboard-root">
            <padding><Insets top="22" right="24" bottom="24" left="24"/></padding>

            <VBox spacing="5">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="⌂" styleClass="dashboard-heading-icon"/>
                    <Label text="Dashboard" styleClass="dashboard-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="LIVE OVERZICHT" styleClass="dashboard-live-pill"/>
                </HBox>
                <Label text="Overzicht van je accounts, taken, automatisering en systeemstatus." styleClass="dashboard-subtitle"/>
            </VBox>

            <GridPane hgap="12" vgap="12" styleClass="dashboard-metrics">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                </columnConstraints>
                <HBox styleClass="dashboard-metric-card" spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="0">
                    <Label text="♟" styleClass="metric-icon metric-blue"/>
                    <VBox spacing="4"><Label fx:id="accountCount" text="— Accounts" styleClass="metric-value"/><Label fx:id="accountDetail" text="Accounts worden geladen" styleClass="metric-detail"/></VBox>
                </HBox>
                <HBox styleClass="dashboard-metric-card" spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="1">
                    <Label text="✓" styleClass="metric-icon metric-green"/>
                    <VBox spacing="4"><Label fx:id="queueCount" text="— Wachtrijen" styleClass="metric-value"/><Label fx:id="queueDetail" text="Wachtrijen worden geladen" styleClass="metric-detail"/></VBox>
                </HBox>
                <HBox styleClass="dashboard-metric-card" spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="2">
                    <Label text="⟳" styleClass="metric-icon metric-blue"/>
                    <VBox spacing="4"><Label text="Volgende actie" styleClass="metric-caption"/><Label fx:id="nextActionValue" text="Nog geen actie" styleClass="metric-value"/><Label fx:id="engineState" text="Automatisering gestopt" styleClass="metric-detail"/></VBox>
                </HBox>
                <HBox styleClass="dashboard-metric-card" spacing="14" alignment="CENTER_LEFT" GridPane.columnIndex="3">
                    <Label text="◷" styleClass="metric-icon metric-green"/>
                    <VBox spacing="4"><Label text="Sessie" styleClass="metric-caption"/><Label fx:id="uptimeValue" text="00:00:00" styleClass="metric-value"/><Label text="Actieve runtime" styleClass="metric-detail"/></VBox>
                </HBox>
            </GridPane>

            <GridPane hgap="14" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="63" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="37" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox styleClass="dashboard-panel" spacing="13" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="♟" styleClass="panel-icon"/><Label text="Accountstatus" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/><Label text="LIVE STATUS" styleClass="panel-overline"/>
                    </HBox>
                    <GridPane styleClass="dashboard-table-header" hgap="10">
                        <columnConstraints><ColumnConstraints percentWidth="31"/><ColumnConstraints percentWidth="18"/><ColumnConstraints percentWidth="27"/><ColumnConstraints percentWidth="24"/></columnConstraints>
                        <Label text="Account" GridPane.columnIndex="0"/><Label text="Status" GridPane.columnIndex="1"/><Label text="Huidige taak" GridPane.columnIndex="2"/><Label text="Volgende actie" GridPane.columnIndex="3"/>
                    </GridPane>
                    <VBox fx:id="accountRows" spacing="8"/>
                    <Label fx:id="accountEmpty" text="Nog geen accounts beschikbaar. Voeg een account toe om hier de status te zien." styleClass="dashboard-empty" wrapText="true"/>
                </VBox>
                <VBox styleClass="dashboard-panel" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10"><Label text="⚙" styleClass="panel-icon"/><Label text="Systeemoverzicht" styleClass="panel-title"/></HBox>
                    <HBox alignment="CENTER_LEFT"><Label text="CPU" styleClass="system-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="cpuValue" text="Niet beschikbaar" styleClass="system-value"/></HBox>
                    <ProgressBar fx:id="cpuBar" progress="0" maxWidth="Infinity" styleClass="system-progress"/>
                    <HBox alignment="CENTER_LEFT"><Label text="Geheugen" styleClass="system-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="memoryValue" text="Niet beschikbaar" styleClass="system-value"/></HBox>
                    <ProgressBar fx:id="memoryBar" progress="0" maxWidth="Infinity" styleClass="system-progress"/>
                    <Separator styleClass="dashboard-separator"/>
                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="●" styleClass="system-dot system-dot-neutral"/><Label text="ADB" styleClass="system-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="adbValue" text="Niet gecontroleerd" styleClass="system-value"/></HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="◈" styleClass="system-symbol"/><Label text="OCR / Vision" styleClass="system-label"/><Region HBox.hgrow="ALWAYS"/><Label text="Module-integratie" styleClass="system-value"/></HBox>
                </VBox>
            </GridPane>

            <GridPane hgap="14" vgap="14">
                <columnConstraints><ColumnConstraints percentWidth="58" hgrow="ALWAYS"/><ColumnConstraints percentWidth="42" hgrow="ALWAYS"/></columnConstraints>
                <VBox styleClass="dashboard-panel" spacing="13" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10"><Label text="⚙" styleClass="panel-icon"/><Label text="Actieve routine" styleClass="panel-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="routineBadge" text="GESTOPT" styleClass="routine-state-pill"/></HBox>
                    <Label text="Standaard WOS Routine" styleClass="routine-name"/>
                    <HBox fx:id="routineSteps" alignment="CENTER_LEFT" spacing="0" styleClass="routine-stepper">
                        <VBox alignment="CENTER" spacing="6" styleClass="routine-step"><Label text="1" styleClass="routine-step-number"/><Label text="Verzamelen" styleClass="routine-step-label"/></VBox>
                        <Region HBox.hgrow="ALWAYS" styleClass="routine-step-line"/>
                        <VBox alignment="CENTER" spacing="6" styleClass="routine-step"><Label text="2" styleClass="routine-step-number"/><Label text="Bouw" styleClass="routine-step-label"/></VBox>
                        <Region HBox.hgrow="ALWAYS" styleClass="routine-step-line"/>
                        <VBox alignment="CENTER" spacing="6" styleClass="routine-step"><Label text="3" styleClass="routine-step-number"/><Label text="Onderzoek" styleClass="routine-step-label"/></VBox>
                        <Region HBox.hgrow="ALWAYS" styleClass="routine-step-line"/>
                        <VBox alignment="CENTER" spacing="6" styleClass="routine-step"><Label text="4" styleClass="routine-step-number"/><Label text="Training" styleClass="routine-step-label"/></VBox>
                        <Region HBox.hgrow="ALWAYS" styleClass="routine-step-line"/>
                        <VBox alignment="CENTER" spacing="6" styleClass="routine-step"><Label text="5" styleClass="routine-step-number"/><Label text="Marsen" styleClass="routine-step-label"/></VBox>
                    </HBox>
                    <Separator styleClass="dashboard-separator"/>
                    <HBox spacing="24" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="HUIDIGE STATUS" styleClass="panel-overline"/><Label fx:id="routineState" text="Geen actieve routine." styleClass="routine-current-value" wrapText="true"/></VBox>
                        <VBox spacing="4"><Label text="VOLGENDE ACTIE" styleClass="panel-overline"/><Label fx:id="routineNextAction" text="—" styleClass="routine-current-value" wrapText="true"/></VBox>
                    </HBox>
                </VBox>
                <VBox styleClass="dashboard-panel" spacing="12" GridPane.columnIndex="1">
                    <HBox alignment="CENTER_LEFT" spacing="10"><Label text="▤" styleClass="panel-icon"/><Label text="Recente activiteit" styleClass="panel-title"/><Region HBox.hgrow="ALWAYS"/><Label text="LAATSTE 5" styleClass="panel-overline"/></HBox>
                    <VBox fx:id="activityRows" spacing="8" />
                    <Label fx:id="activityEmpty" text="Nog geen activiteit geregistreerd." styleClass="dashboard-empty" wrapText="true"/>
                </VBox>
            </GridPane>
        </VBox>
    </content>
</ScrollPane>
