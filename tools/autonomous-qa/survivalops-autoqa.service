[Unit]
Description=SurvivalOps autonomous QA worker (single pinned Serve-EMU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/survivalops-autonomous-qa
ExecStart=/usr/bin/python3 %h/survivalops-autonomous-qa/controller.py worker
Restart=on-failure
RestartSec=8
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
